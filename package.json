{
  "name": "fixed-scramjet-app",
  "version": "1.0.0",
  "description": "Deployable fixed Scramjet test application",
  "private": true,
  "type": "module",
  "keywords": [],
  "author": "Mercury Workshop",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "start": "node app/server.mjs",
    "prepare:client-assets": "node scripts/prepare-client-assets.mjs",
    "test:app": "node --test tests/deploy-app.test.mjs",
    "dev": "node --no-warnings=ExperimentalWarning devserver.ts",
    "dev:debug": "DEBUG=1 node --no-warnings=ExperimentalWarning devserver.ts",
    "test:package": "ava tests/ci/packageValidation.js",
    "preinstall": "npx only-allow pnpm"
  },
  "ava": {
    "files": [
      "tests/ci/**/*.js"
    ],
    "verbose": true
  },
  "devDependencies": {
    "@fastify/deepmerge": "^3.2.1",
    "@rsdoctor/rspack-plugin": "^1.4.0",
    "@rspack/cli": "^1.5.8",
    "@rspack/core": "^1.5.8",
    "@types/node": "24.9.1",
    "ava": "^6.4.1",
    "chafa-wasm": "^0.3.1",
    "chalk": "^5.6.2",
    "eslint": "^10.2.0",
    "glob": "^13.0.6",
    "ts-checker-rspack-plugin": "^1.1.6",
    "tsc-alias": "^1.8.16",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@mercuryworkshop/wisp-js": "catalog:",
    "prettier": "^3.6.2"
  }
}
